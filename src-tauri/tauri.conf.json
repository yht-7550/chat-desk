{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatDesk",
  "version": "0.1.0",
  "identifier": "com.chatdesk.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChatDesk",
        "width": 1280,
        "height": 840,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "静态 Web 应用的桌面外壳",
    "longDescription": "ChatDesk 是一个基于 Vite + Vue3 + Pinia + Tauri 的桌面外壳，用于把已有的静态打包产物以桌面应用的形式分发。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
